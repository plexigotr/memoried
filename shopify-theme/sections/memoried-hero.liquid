<section class="hero-section">
  <div class="hero-glow"></div>
  <div class="hero-inner">
    <p class="eyebrow">{{ section.settings.eyebrow }}</p>
    <h1>{{ section.settings.heading }}</h1>
    <p class="hero-copy">{{ section.settings.copy }}</p>
    <div class="hero-actions">
      <a class="button button-dark" href="#memoried-product">{{ section.settings.primary_label }}</a>
      <a class="button button-light" href="#nasil-calisir">{{ section.settings.secondary_label }}</a>
      <a class="text-link" href="{{ settings.memory_app_url | default: 'https://app.memoried.me/account' }}">Hesabıma giriş</a>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Memoried kahraman alanı",
  "settings": [
    {"type":"text","id":"eyebrow","label":"Üst yazı","default":"STORY MAGNET"},
    {"type":"text","id":"heading","label":"Başlık","default":"Anılarını dokunarak yeniden yaşa"},
    {"type":"textarea","id":"copy","label":"Açıklama","default":"Fotoğraflarını, videolarını, notlarını ve ses kayıtlarını tek bir hikâyede buluşturan premium NFC anı deneyimi."},
    {"type":"text","id":"primary_label","label":"Birinci düğme","default":"Başlayalım"},
    {"type":"text","id":"secondary_label","label":"İkinci düğme","default":"Nasıl çalışır?"}
  ],
  "presets": [{"name":"Memoried kahraman alanı"}]
}
{% endschema %}
