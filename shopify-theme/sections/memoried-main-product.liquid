<section class="main-product-shell">
  <div class="main-product-gallery">
    <div class="main-product-media">
      {% if product.featured_media %}
        {{ product.featured_media | image_url: width: 1400 | image_tag: loading: 'eager', alt: product.title }}
      {% else %}
        <img src="{{ 'magnet.png' | asset_url }}" alt="{{ product.title | escape }}" width="1200" height="1200">
      {% endif %}
    </div>
    <div class="product-info-visual">
      <img src="{{ 'memoried-shop-info.png' | asset_url }}" alt="Memoried Stone özellikleri ve kullanım adımları" width="1365" height="2048" loading="lazy">
    </div>
  </div>
  <div class="main-product-copy">
    <p class="eyebrow">DOĞAL TAŞ ANI MAGNETİ</p>
    <h1>{{ product.title }}</h1>
    <div class="product-assurances" aria-label="Ürün avantajları">
      <span>Türkiye'ye ücretsiz kargo</span>
      <span>3 iş gününde kargoda</span>
      <span>Pil gerektirmez</span>
    </div>
    <div class="rte">{{ product.description | replace: '10 fotoğraf, 1 kısa video', '20 fotoğraf, 2 kısa video' }}</div>
    {% form 'product', product, class: 'memoried-product-form memoried-checkout-card' %}
      <p class="memoried-checkout-title">Paketini seç</p>
      <fieldset class="memoried-package-options">
        <legend class="visually-hidden">Paket seçenekleri</legend>
        {% for variant in product.variants %}
          <label class="memoried-package-option{% if variant == product.selected_or_first_available_variant %} is-selected{% endif %}">
            <input
              type="radio"
              name="id"
              value="{{ variant.id }}"
              data-variant-option
              data-price="{{ variant.price | money }}"
              {% if variant == product.selected_or_first_available_variant %}checked{% endif %}
              {% unless variant.available %}disabled{% endunless %}
            >
            <span class="memoried-package-option-copy">
              <span class="memoried-package-option-heading">
                <strong>{{ variant.title }}</strong>
                <b>{{ variant.price | money }}</b>
              </span>
              {% if variant.title contains 'Premium' %}
                <small>50 fotoğraf · 10 kısa video · Sınırsız metin ve ses kaydı</small>
              {% else %}
                <small>20 fotoğraf · 2 kısa video · Sınırsız metin ve ses kaydı</small>
              {% endif %}
              {% unless variant.available %}<em>Tükendi</em>{% endunless %}
            </span>
          </label>
        {% endfor %}
      </fieldset>

      <label for="MemoriedEngraving-{{ section.id }}">
        Magnet üzerindeki yazı
        <small>(en fazla 30 karakter)</small>
      </label>
      <input
        id="MemoriedEngraving-{{ section.id }}"
        type="text"
        name="properties[Magnet üzerindeki yazı]"
        maxlength="30"
        placeholder="Örn. Bizim Hikâyemiz"
        required
      >

      <label class="gift-check" for="MemoriedGiftPackage-{{ section.id }}">
        <input
          id="MemoriedGiftPackage-{{ section.id }}"
          type="checkbox"
          name="properties[Hediye paketi]"
          value="Evet"
        >
        <span>
          <strong>Hediye paketi istiyorum</strong>
          <small>Siparişini hediye sunumuyla hazırlayalım.</small>
        </span>
      </label>

      <button
        class="button button-dark button-wide"
        type="submit"
        name="add"
        {% unless product.selected_or_first_available_variant.available %}disabled{% endunless %}
      >
        Sepete Ekle · <span data-product-price>{{ product.selected_or_first_available_variant.price | money }}</span>
      </button>
      <small class="memoried-payment-note">Telefon ve teslimat bilgilerini güvenli Shopify ödeme ekranında gireceksin. Ödeme iyzico ile alınır.</small>
    {% endform %}
    <div class="memory-after-order">
      <span class="memory-after-order-number">01</span>
      <div>
        <strong>Anılarını siparişten sonra ekle</strong>
        <p>Fotoğraf, video, mesaj ve konumlarını <a href="{{ settings.memory_app_url | default: 'https://app.memoried.me/account' }}">Anılarım</a> alanından güvenle yükleyebilirsin.</p>
      </div>
    </div>
    <details class="product-detail" open>
      <summary>Nasıl çalışır?</summary>
      <p>Siparişinden sonra anı sayfanı oluştur. Telefonunu Memoried Stone'a dokundurduğunda NFC teknolojisi kişisel anı sayfanı açar.</p>
    </details>
    <details class="product-detail">
      <summary>Kargo ve teslimat</summary>
      <p>Ürün en geç 3 iş günü içinde kargoya teslim edilir. Türkiye gönderimleri ücretsiz, uluslararası gönderimler 900 TL'dir.</p>
    </details>
    <div class="trust-row"><span>Özenli paketleme</span><span>Kişisel anı sayfası</span><span>Tüm NFC telefonlarla uyumlu</span></div>
  </div>
</section>

{% schema %}
{"name":"Memoried ürün sayfası","settings":[]}
{% endschema %}
