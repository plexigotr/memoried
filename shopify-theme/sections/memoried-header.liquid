<header class="site-header">
  <a class="brand" href="{{ routes.root_url }}" aria-label="{{ shop.name }} ana sayfa">
    <span class="brand-mark">M</span>
    <span>Memoried</span>
  </a>
  <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="MemoriedMenu">
    <span></span><span></span><span></span>
    <span class="visually-hidden">Menüyü aç</span>
  </button>
  <nav class="header-actions" id="MemoriedMenu" aria-label="Ana menü">
    <a href="{{ routes.root_url }}">Ana Sayfa</a>
    <a href="{{ routes.all_products_collection_url }}">Ürün</a>
    <a href="{{ routes.root_url }}#nasil-calisir">Nasıl Çalışır?</a>
    <a href="{{ settings.memory_app_url | default: 'https://app.memoried.me/account' }}">Anılarım</a>
    <a class="cart-pill" href="{{ routes.cart_url }}">Sepet <span>{{ cart.item_count }}</span></a>
  </nav>
</header>

{% schema %}
{
  "name": "Memoried üst menü",
  "settings": []
}
{% endschema %}
