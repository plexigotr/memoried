:root{--paper:{{ settings.background | default: '#f7f2eb' }};--ink:{{ settings.text | default: '#241f1b' }};--accent:{{ settings.accent | default: '#c8893d' }};--muted:#756d66;--line:rgba(60,45,34,.12);--white:rgba(255,255,255,.76);font-family:Inter,ui-sans-serif,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;color:var(--ink);background:var(--paper)}*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;background:radial-gradient(circle at 50% 3%,rgba(255,255,255,.9),transparent 28rem),var(--paper);color:var(--ink)}a{color:inherit;text-decoration:none}img{max-width:100%;display:block}.skip-link{position:absolute;left:-9999px}.skip-link:focus{left:16px;top:16px;z-index:100;padding:12px 16px;background:#fff;border-radius:999px}.site-header{position:sticky;top:0;z-index:40;display:flex;align-items:center;justify-content:space-between;gap:24px;padding:18px clamp(18px,4vw,60px);background:rgba(247,242,235,.78);border-bottom:1px solid rgba(255,255,255,.85);backdrop-filter:blur(18px)}.brand{display:flex;align-items:center;gap:10px;font-weight:750;letter-spacing:-.03em}.brand-mark{display:grid;place-items:center;width:30px;height:30px;border-radius:50%;background:#241f1b;color:#fff;font-family:Georgia,serif}.header-actions{display:flex;align-items:center;gap:22px;font-size:13px;font-weight:650}.cart-pill{padding:10px 14px;border:1px solid var(--line);border-radius:999px;background:rgba(255,255,255,.58)}.cart-pill span{display:inline-grid;place-items:center;margin-left:6px;min-width:19px;height:19px;padding:0 5px;border-radius:999px;background:#241f1b;color:#fff;font-size:10px}.hero-section{position:relative;min-height:78vh;display:grid;place-items:center;padding:96px 22px 82px;text-align:center;overflow:hidden}.hero-glow{position:absolute;left:50%;top:9%;width:min(78vw,760px);height:440px;transform:translateX(-50%);border-radius:50%;background:rgba(255,255,255,.82);filter:blur(70px)}.hero-inner{position:relative;max-width:900px}.eyebrow{margin:0 0 18px;color:#8e837a;font-size:11px;font-weight:750;letter-spacing:.38em;text-transform:uppercase}.hero-section h1{max-width:850px;margin:0 auto;font-family:Georgia,"Times New Roman",serif;font-size:clamp(52px,8.5vw,112px);font-weight:500;line-height:.94;letter-spacing:-.065em}.hero-copy{max-width:650px;margin:28px auto 0;color:var(--muted);font-size:clamp(16px,2vw,20px);line-height:1.72}.hero-actions{display:flex;align-items:center;justify-content:center;flex-wrap:wrap;gap:12px;margin-top:36px}.button{display:inline-flex;align-items:center;justify-content:center;min-height:50px;padding:14px 24px;border:1px solid transparent;border-radius:999px;font:inherit;font-size:13px;font-weight:750;letter-spacing:.04em;cursor:pointer;transition:transform .2s,box-shadow .2s,background .2s}.button:hover{transform:translateY(-2px)}.button-dark{background:#241f1b;color:#fff;box-shadow:0 14px 35px rgba(36,31,27,.18)}.button-light{border-color:var(--line);background:rgba(255,255,255,.55);color:var(--ink)}.button-wide{width:100%}.text-link{padding:14px 10px;font-size:13px;font-weight:700;text-decoration:underline;text-underline-offset:4px}.product-showcase{padding:20px 20px 100px;scroll-margin-top:90px}.product-card{width:min(100%,520px);margin:0 auto;padding:10px;border:1px solid rgba(255,255,255,.95);border-radius:48px;background:var(--white);box-shadow:0 42px 110px rgba(112,82,52,.18);backdrop-filter:blur(18px)}.product-visual{height:min(70vh,520px);overflow:hidden;border-radius:39px;background:#e9dfd2}.product-visual img{width:100%;height:100%;object-fit:cover;transition:transform .6s}.product-card:hover .product-visual img{transform:scale(1.025)}.product-copy{padding:28px 18px 20px}.product-heading-row,.product-price-row{display:flex;justify-content:space-between;align-items:flex-start;gap:20px}.product-heading-row .eyebrow{margin:0 0 8px;font-size:9px}.product-heading-row h2{margin:0;font-family:Georgia,serif;font-size:32px;font-weight:500;letter-spacing:-.04em}.limited-pill{padding:7px 12px;border-radius:999px;background:#f1ece5;color:#7b726b;font-size:10px}.product-copy>p{color:var(--muted);font-size:14px;line-height:1.7}.product-price-row{align-items:flex-end;margin:26px 0}.product-price-row small,.product-price-row strong{display:block}.product-price-row small{color:#968c84;font-size:10px}.product-price-row strong{margin-top:4px;font-family:Georgia,serif;font-size:34px;font-weight:500}.product-price-row p{margin:0;text-align:right;color:#8d837b;font-size:11px;line-height:1.6}.micro-copy{text-align:center;font-size:10px!important}.story-section{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:22px;width:min(1120px,calc(100% - 40px));margin:0 auto;padding:0 0 110px}.story-photo-card,.story-copy-card{overflow:hidden;border:1px solid rgba(255,255,255,.85);border-radius:44px;background:rgba(255,255,255,.54);box-shadow:0 28px 75px rgba(112,82,52,.11)}.story-photo-card img{width:100%;height:100%;min-height:560px;object-fit:cover}.story-copy-card{display:flex;flex-direction:column;justify-content:center;padding:clamp(38px,7vw,78px)}.story-copy-card h2,.steps-section h2{margin:0;font-family:Georgia,serif;font-size:clamp(42px,6vw,74px);font-weight:500;line-height:1;letter-spacing:-.055em}.story-copy-card>p:not(.eyebrow){color:var(--muted);line-height:1.8}.story-copy-card ul{display:grid;gap:14px;margin:24px 0 0;padding:0;list-style:none}.story-copy-card li{position:relative;padding-left:28px;font-size:14px}.story-copy-card li:before{content:"";position:absolute;left:0;top:7px;width:10px;height:10px;border-radius:50%;background:var(--accent);box-shadow:0 0 0 5px rgba(200,137,61,.12)}.steps-section{width:min(1120px,calc(100% - 40px));margin:0 auto;padding:0 0 130px;text-align:center;scroll-margin-top:95px}.steps-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:14px;margin-top:44px;text-align:left}.step-card{min-height:230px;padding:26px;border:1px solid rgba(255,255,255,.88);border-radius:30px;background:rgba(255,255,255,.6);box-shadow:0 18px 45px rgba(112,82,52,.08)}.step-card>span{display:grid;place-items:center;width:42px;height:42px;border-radius:50%;background:#241f1b;color:#fff;font-size:11px;font-weight:800}.step-card h3{margin:34px 0 10px;font-family:Georgia,serif;font-size:22px;font-weight:500}.step-card p{margin:0;color:var(--muted);font-size:13px;line-height:1.65}.site-footer{padding:64px 20px 34px;text-align:center;border-top:1px solid var(--line);background:rgba(255,255,255,.34)}.footer-brand{font-family:Georgia,serif;font-size:28px}.site-footer p{color:var(--muted);font-size:13px}.site-footer nav{display:flex;justify-content:center;flex-wrap:wrap;gap:18px;margin:28px 0;font-size:12px}.site-footer small{color:#968c84;font-size:10px;letter-spacing:.18em;text-transform:uppercase}.main-product-shell{display:grid;grid-template-columns:minmax(0,1.1fr) minmax(380px,.9fr);gap:clamp(32px,6vw,90px);width:min(1180px,calc(100% - 40px));margin:0 auto;padding:70px 0 110px}.main-product-media{overflow:hidden;min-height:620px;border-radius:46px;background:#e7ddd0;box-shadow:0 36px 90px rgba(95,70,45,.18)}.main-product-media img{width:100%;height:100%;object-fit:cover}.main-product-copy{align-self:center}.main-product-copy h1,.cart-shell h1,.page-shell h1,.empty-shell h1{margin:0 0 24px;font-family:Georgia,serif;font-size:clamp(48px,6vw,76px);font-weight:500;line-height:1;letter-spacing:-.055em}.rte{color:var(--muted);line-height:1.75}.memoried-product-form{display:grid;gap:12px;margin-top:30px}.memoried-product-form>label:not(.gift-check){margin-top:8px;font-size:12px;font-weight:750}.memoried-product-form select,.memoried-product-form input[type=text]{width:100%;padding:16px 17px;border:1px solid var(--line);border-radius:18px;background:rgba(255,255,255,.72);color:var(--ink);font:inherit}.gift-check{display:flex;gap:12px;align-items:flex-start;margin:10px 0;padding:16px;border:1px solid var(--line);border-radius:20px;background:rgba(255,255,255,.55)}.gift-check input{margin-top:3px}.gift-check strong,.gift-check small{display:block}.gift-check small{margin-top:4px;color:var(--muted)}.trust-row{display:flex;flex-wrap:wrap;gap:8px;margin-top:18px}.trust-row span{padding:8px 11px;border-radius:999px;background:rgba(255,255,255,.55);color:#796f66;font-size:10px}.cart-shell,.page-shell,.empty-shell{width:min(960px,calc(100% - 40px));min-height:60vh;margin:0 auto;padding:76px 0 110px}.cart-items{display:grid;gap:14px}.cart-item{display:grid;grid-template-columns:120px 1fr auto;gap:20px;align-items:center;padding:16px;border:1px solid var(--line);border-radius:26px;background:rgba(255,255,255,.65)}.cart-item img{width:120px;height:120px;object-fit:cover;border-radius:18px}.cart-item h2{margin:0 0 6px;font-family:Georgia,serif;font-weight:500}.cart-item small{display:block;color:var(--muted)}.cart-item label{display:block;margin-top:10px;font-size:11px}.cart-item input{width:65px;margin-left:6px;padding:7px;border:1px solid var(--line);border-radius:10px}.cart-summary{width:min(100%,420px);margin:28px 0 0 auto;padding:24px;border-radius:26px;background:rgba(255,255,255,.7)}.cart-summary p{display:flex;justify-content:space-between}.cart-summary .button{width:100%;margin-top:10px}.page-shell{width:min(760px,calc(100% - 40px))}.empty-shell{text-align:center}.empty-shell .button{margin-top:20px}@media(max-width:900px){.story-section{grid-template-columns:1fr}.story-photo-card img{min-height:430px}.steps-grid{grid-template-columns:repeat(2,1fr)}.main-product-shell{grid-template-columns:1fr}.main-product-media{min-height:0;aspect-ratio:1/1}}@media(max-width:640px){.site-header{padding:14px 16px}.header-actions>a:not(.cart-pill){display:none}.hero-section{min-height:72vh;padding-top:70px}.hero-section h1{font-size:clamp(48px,16vw,72px)}.product-card{border-radius:38px}.product-visual{height:420px;border-radius:31px}.story-section,.steps-section,.main-product-shell,.cart-shell,.page-shell,.empty-shell{width:calc(100% - 28px)}.story-photo-card,.story-copy-card{border-radius:32px}.story-photo-card img{min-height:360px}.story-copy-card{padding:36px 26px}.steps-grid{grid-template-columns:1fr}.step-card{min-height:0}.main-product-shell{padding-top:28px}.main-product-media{border-radius:30px}.cart-item{grid-template-columns:82px 1fr}.cart-item img{width:82px;height:82px}.cart-item>strong{grid-column:2}.product-price-row{align-items:flex-start}}
