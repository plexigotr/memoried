# Application
NODE_ENV=production
APP_BASE_URL=https://memoried.me
BASE_URL=https://memoried.me
SESSION_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
ADMIN_PASSWORD=REPLACE_WITH_A_STRONG_ADMIN_PASSWORD

# PostgreSQL on the VPS
DATABASE_URL=postgresql://memoried_app:REPLACE_DB_PASSWORD@127.0.0.1:5432/memoried?schema=public

# Cloudflare R2
R2_ACCOUNT_ID=REPLACE_R2_ACCOUNT_ID
R2_ACCESS_KEY_ID=REPLACE_R2_ACCESS_KEY_ID
R2_SECRET_ACCESS_KEY=REPLACE_R2_SECRET_ACCESS_KEY
R2_BUCKET_NAME=memoried-media

# Twilio Verify
TWILIO_ACCOUNT_SID=REPLACE_TWILIO_ACCOUNT_SID
TWILIO_AUTH_TOKEN=REPLACE_TWILIO_AUTH_TOKEN
TWILIO_VERIFY_SERVICE_SID=REPLACE_TWILIO_VERIFY_SERVICE_SID

# Temporary Shopier redirects
SHOPIER_STARTER_URL=https://www.shopier.com/REPLACE_STARTER_PRODUCT
SHOPIER_PREMIUM_URL=https://www.shopier.com/REPLACE_PREMIUM_PRODUCT

# Video processing on AlmaLinux
FFMPEG_PATH=/usr/bin/ffmpeg
FFPROBE_PATH=/usr/bin/ffprobe

# Keep empty until automatic card payments are implemented
IYZICO_API_KEY=
IYZICO_SECRET_KEY=
IYZICO_BASE_URL=https://sandbox-api.iyzipay.com
